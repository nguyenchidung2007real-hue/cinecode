// ==============================================================================
// CINEMAX AI - ENTERPRISE DATABASE SCHEMA (PRISMA ORM - 29 BẢNG)
// Khớp 100% với đặc tả database_schema.dbml
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// NHÓM 1: ĐỊA ĐIỂM, PHÒNG CHIẾU & GHẾ VẬT LÝ (3 BẢNG)
// ------------------------------------------------------------------------------

model Cinema {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  address     String
  ward        String?
  district    String
  city        String
  latitude    Float?
  longitude   Float?
  phone       String?
  amenities   String?  // JSON array dạng chuỗi: ["Bãi đỗ ô tô", "Máy lạnh", ...]
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  halls       Hall[]
  concessions Concession[]

  @@map("cinemas")
}

model Hall {
  id            String   @id @default(uuid())
  cinemaId      String   @map("cinema_id")
  name          String
  hallType      String   @map("hall_type") // STANDARD_2D, DIGITAL_3D, IMAX_LASER, FOUR_DX, SCREEN_X
  soundSystem   String?  @default("Dolby Atmos 7.1") @map("sound_system")
  projectorType String?  @default("Christie 4K Laser") @map("projector_type")
  totalSeats    Int      @map("total_seats")
  rowsCount     Int      @map("rows_count")
  colsCount     Int      @map("cols_count")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cinema        Cinema   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  seatTemplates SeatTemplate[]
  showtimes     Showtime[]

  @@map("halls")
}

model SeatTemplate {
  id         String   @id @default(uuid())
  hallId     String   @map("hall_id")
  rowCode    String   @map("row_code")
  seatNumber Int      @map("seat_number")
  seatType   String   @map("seat_type") // STANDARD, VIP, SWEETBOX, AISLE
  coordX     Int      @map("coord_x")
  coordY     Int      @map("coord_y")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  hall       Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)
  showtimeSeats ShowtimeSeat[]

  @@unique([hallId, rowCode, seatNumber])
  @@map("seat_templates")
}

// ------------------------------------------------------------------------------
// NHÓM 2: PHIM, THỂ LOẠI & LỊCH SUẤT CHIẾU (5 BẢNG)
// ------------------------------------------------------------------------------

model Genre {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  movieGenres MovieGenre[]

  @@map("genres")
}

model Movie {
  id               String   @id @default(uuid())
  title            String
  originalTitle    String?  @map("original_title")
  slug             String   @unique
  overview         String?
  posterUrl        String   @map("poster_url")
  backdropUrl      String?  @map("backdrop_url")
  trailerYoutubeId String?  @map("trailer_youtube_id")
  durationMin      Int      @map("duration_min")
  releaseDate      DateTime @map("release_date")
  endDate          DateTime? @map("end_date")
  ageRating        String   @map("age_rating") // P, K, T13, T16, T18, C
  director         String?
  castMembers      String?  @map("cast_members") // JSON serialized array
  producer         String?
  country          String?  @default("Việt Nam")
  ratingAverage    Float    @default(0.0) @map("rating_average")
  ratingCount      Int      @default(0) @map("rating_count")
  status           String   @default("NOW_SHOWING") // NOW_SHOWING, COMING_SOON, SNEAK_SHOW, ENDED
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  movieGenres      MovieGenre[]
  showtimes        Showtime[]
  reviews          MovieReview[]
  watchlists       MovieWatchlist[]

  @@map("movies")
}

model MovieGenre {
  movieId String @map("movie_id")
  genreId String @map("genre_id")

  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@map("movie_genres")
}

model Showtime {
  id                  String   @id @default(uuid())
  movieId             String   @map("movie_id")
  hallId              String   @map("hall_id")
  startTime           DateTime @map("start_time")
  endTime             DateTime @map("end_time")
  format              String   @default("2D Phụ Đề")
  basePrice           Float    @map("base_price")
  status              String   @default("SCHEDULED") // SCHEDULED, OPEN_BOOKING, FINISHED
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  movie               Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  hall                Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)
  showtimeSeats       ShowtimeSeat[]
  bookings            Booking[]
  groupBookings       GroupBooking[]
  waitingRoomSessions WaitingRoomSession[]

  @@map("showtimes")
}

model ShowtimeSeat {
  id                    String    @id @default(uuid())
  showtimeId            String    @map("showtime_id")
  seatTemplateId        String    @map("seat_template_id")
  status                String    @default("AVAILABLE") // AVAILABLE, HOLD, BOOKED
  price                 Float
  reservedByUserId      String?   @map("reserved_by_user_id")
  reservationExpiresAt  DateTime? @map("reservation_expires_at")
  version               Int       @default(1)
  updatedAt             DateTime  @updatedAt @map("updated_at")

  showtime              Showtime     @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seatTemplate          SeatTemplate @relation(fields: [seatTemplateId], references: [id], onDelete: Cascade)
  ticket                Ticket?
  groupBookingMembers   GroupBookingMember[]

  @@unique([showtimeId, seatTemplateId])
  @@map("showtime_seats")
}

// ------------------------------------------------------------------------------
// NHÓM 3: NGƯỜI DÙNG, ĐƠN ĐẶT VÉ & VÉ ĐIỆN TỬ (3 BẢNG)
// ------------------------------------------------------------------------------

model User {
  id             String   @id @default(uuid())
  fullName       String   @map("full_name")
  email          String   @unique
  phone          String?  @unique
  passwordHash   String?  @map("password_hash")
  role           String   @default("CUSTOMER") // CUSTOMER, STAFF, CINEMA_MANAGER, SUPER_ADMIN
  avatarUrl      String?  @map("avatar_url")
  loyaltyPoints  Int      @default(0) @map("loyalty_points")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  bookings                Booking[]
  ticketsCheckedIn        Ticket[]                 @relation("StaffCheckIn")
  concessionDeliveries    ConcessionDelivery[]
  auditLogs               SystemAuditLog[]
  refundRequests          RefundRequest[]          @relation("UserRefunds")
  refundsProcessed        RefundRequest[]          @relation("StaffProcessedRefunds")
  loyaltyTransactions     UserLoyaltyTransaction[]
  couponRedemptions       CouponRedemption[]
  giftCardsSent           GiftCard[]
  reviews                 MovieReview[]
  reviewLikes             ReviewLike[]
  watchlists              MovieWatchlist[]
  groupBookingsLed        GroupBooking[]           @relation("GroupLeader")
  groupBookingMemberships GroupBookingMember[]

  @@map("users")
}

model Booking {
  id             String   @id @default(uuid())
  bookingCode    String   @unique @map("booking_code")
  userId         String   @map("user_id")
  showtimeId     String   @map("showtime_id")
  totalAmount    Float    @map("total_amount")
  discountAmount Float    @default(0) @map("discount_amount")
  finalAmount    Float    @map("final_amount")
  paymentStatus  String   @default("PENDING") @map("payment_status") // PENDING, PAID, EXPIRED, REFUNDED
  idempotencyKey String   @unique @map("idempotency_key")
  customerNotes  String?  @map("customer_notes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  showtime               Showtime                @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  tickets                Ticket[]
  bookingConcessions     BookingConcession[]
  concessionDeliveries   ConcessionDelivery[]
  payments               Payment[]
  refundRequests         RefundRequest[]
  loyaltyTransactions    UserLoyaltyTransaction[]
  couponRedemptions      CouponRedemption[]
  giftCardTransactions   GiftCardTransaction[]
  movieReviews           MovieReview[]

  @@map("bookings")
}

model Ticket {
  id                 String    @id @default(uuid())
  bookingId          String    @map("booking_id")
  showtimeSeatId     String    @unique @map("showtime_seat_id")
  ticketCode         String    @unique @map("ticket_code")
  qrCodePayload      String    @map("qr_code_payload")
  isCheckedIn        Boolean   @default(false) @map("is_checked_in")
  checkedInAt        DateTime? @map("checked_in_at")
  checkedInByStaffId String?   @map("checked_in_by_staff_id")
  createdAt          DateTime  @default(now()) @map("created_at")

  booking            Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showtimeSeat       ShowtimeSeat @relation(fields: [showtimeSeatId], references: [id], onDelete: Cascade)
  checkedInByStaff   User?        @relation("StaffCheckIn", fields: [checkedInByStaffId], references: [id])

  @@map("tickets")
}

// ------------------------------------------------------------------------------
// NHÓM 4: BẮP NƯỚC F&B & GIAO TẬN GHẾ (3 BẢNG)
// ------------------------------------------------------------------------------

model Concession {
  id          String   @id @default(uuid())
  cinemaId    String   @map("cinema_id")
  name        String
  category    String   @default("COMBO") // COMBO, POPCORN, BEVERAGE, SNACK
  description String?
  price       Float
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cinema      Cinema   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  bookingConcessions BookingConcession[]

  @@map("concessions")
}

model BookingConcession {
  id           String   @id @default(uuid())
  bookingId    String   @map("booking_id")
  concessionId String   @map("concession_id")
  quantity     Int
  unitPrice    Float    @map("unit_price")
  subtotal     Float
  createdAt    DateTime @default(now()) @map("created_at")

  booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  concession   Concession @relation(fields: [concessionId], references: [id], onDelete: Cascade)

  @@map("booking_concessions")
}

model ConcessionDelivery {
  id                    String    @id @default(uuid())
  bookingId             String    @map("booking_id")
  deliveryType          String    @default("EXPRESS_COUNTER") @map("delivery_type") // EXPRESS_COUNTER, AT_SEAT_DELIVERY
  seatLocation          String?   @map("seat_location")
  estimatedDeliveryTime DateTime? @map("estimated_delivery_time")
  deliveryStatus        String    @default("PREPARING") @map("delivery_status") // PREPARING, DELIVERED
  deliveredByStaffId    String?   @map("delivered_by_staff_id")
  createdAt             DateTime  @default(now()) @map("created_at")

  booking               Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  deliveredByStaff      User?     @relation(fields: [deliveredByStaffId], references: [id])

  @@map("concession_deliveries")
}

// ------------------------------------------------------------------------------
// NHÓM 5: THANH TOÁN, KIỂM TOÁN AN NINH & HOÀN TIỀN (3 BẢNG)
// ------------------------------------------------------------------------------

model Payment {
  id                   String   @id @default(uuid())
  bookingId            String   @map("booking_id")
  gateway              String   // VNPAY, MOMO, ZALOPAY, STRIPE
  gatewayTransactionId String?  @map("gateway_transaction_id")
  amount               Float
  currency             String   @default("VND")
  status               String   // SUCCESS, FAILED
  webhookPayload       String?  @map("webhook_payload") // JSON serialized
  createdAt            DateTime @default(now()) @map("created_at")

  booking              Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model SystemAuditLog {
  id           Int      @id @default(autoincrement())
  userId       String?  @map("user_id")
  action       String   // LOGIN, UPDATE_PRICE, CANCEL_TICKET, SEAT_BLOCKED, ...
  resourceType String   @map("resource_type") // showtimes, tickets, users, seats, ...
  resourceId   String   @map("resource_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     String?  // JSON serialized before & after
  createdAt    DateTime @default(now()) @map("created_at")

  user         User?    @relation(fields: [userId], references: [id])

  @@map("system_audit_logs")
}

model RefundRequest {
  id                  String    @id @default(uuid())
  bookingId           String    @map("booking_id")
  userId              String    @map("user_id")
  reason              String
  originalAmount      Float     @map("original_amount")
  refundAmount        Float     @map("refund_amount")
  penaltyFee          Float     @default(0) @map("penalty_fee")
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED, PROCESSED
  processedByStaffId  String?   @map("processed_by_staff_id")
  processedAt         DateTime? @map("processed_at")
  bankAccountInfo     String?   @map("bank_account_info") // JSON serialized
  createdAt           DateTime  @default(now()) @map("created_at")

  booking             Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user                User      @relation("UserRefunds", fields: [userId], references: [id], onDelete: Cascade)
  processedByStaff    User?     @relation("StaffProcessedRefunds", fields: [processedByStaffId], references: [id])

  @@map("refund_requests")
}

// ------------------------------------------------------------------------------
// NHÓM 6: THÀNH VIÊN, VOUCHER & THẺ QUÀ TẶNG (6 BẢNG)
// ------------------------------------------------------------------------------

model MembershipTier {
  id              String   @id @default(uuid())
  tierName        String   @unique @map("tier_name") // Bronze, Silver, Gold, Diamond
  minSpending     Float    @default(0) @map("min_spending")
  pointMultiplier Float    @default(1.0) @map("point_multiplier")
  benefits        String?  // JSON array
  badgeColor      String   @default("#94a3b8") @map("badge_color")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("membership_tiers")
}

model UserLoyaltyTransaction {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  bookingId       String?  @map("booking_id")
  pointsDelta     Int      @map("points_delta")
  transactionType String   @map("transaction_type") // BOOKING_EARN, REDEEM_DISCOUNT, EXPIRED
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking         Booking? @relation(fields: [bookingId], references: [id])

  @@map("user_loyalty_transactions")
}

model Coupon {
  id                String   @id @default(uuid())
  code              String   @unique
  description       String?
  discountType      String   @map("discount_type") // PERCENTAGE, FIXED_AMOUNT
  discountValue     Float    @map("discount_value")
  minOrderAmount    Float    @default(0) @map("min_order_amount")
  maxDiscountAmount Float?   @map("max_discount_amount")
  totalUsageLimit   Int?     @map("total_usage_limit")
  currentUsageCount Int      @default(0) @map("current_usage_count")
  perUserLimit      Int      @default(1) @map("per_user_limit")
  validFrom         DateTime @map("valid_from")
  validTo           DateTime @map("valid_to")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  redemptions       CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id              String   @id @default(uuid())
  couponId        String   @map("coupon_id")
  userId          String   @map("user_id")
  bookingId       String   @map("booking_id")
  discountApplied Float    @map("discount_applied")
  redeemedAt      DateTime @default(now()) @map("redeemed_at")

  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("coupon_redemptions")
}

model GiftCard {
  id               String   @id @default(uuid())
  cardCode         String   @unique @map("card_code")
  pinHash          String   @map("pin_hash")
  initialBalance   Float    @map("initial_balance")
  currentBalance   Float    @map("current_balance")
  senderUserId     String?  @map("sender_user_id")
  recipientEmail   String?  @map("recipient_email")
  greetingMessage  String?  @map("greeting_message")
  isActive         Boolean  @default(true) @map("is_active")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  sender           User?    @relation(fields: [senderUserId], references: [id])
  transactions     GiftCardTransaction[]

  @@map("gift_cards")
}

model GiftCardTransaction {
  id               String   @id @default(uuid())
  giftCardId       String   @map("gift_card_id")
  bookingId        String?  @map("booking_id")
  amountDeducted   Float    @map("amount_deducted")
  remainingBalance Float    @map("remaining_balance")
  createdAt        DateTime @default(now()) @map("created_at")

  giftCard         GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  booking          Booking? @relation(fields: [bookingId], references: [id])

  @@map("gift_card_transactions")
}

// ------------------------------------------------------------------------------
// NHÓM 7: REVIEW, NHÓM XEM, THEO DÕI & PHÒNG CHỜ ẢO (6 BẢNG)
// ------------------------------------------------------------------------------

model MovieReview {
  id              String   @id @default(uuid())
  movieId         String   @map("movie_id")
  userId          String   @map("user_id")
  bookingId       String?  @map("booking_id")
  ratingScore     Int      @map("rating_score") // 1-10
  title           String?
  content         String?
  hasSpoilers     Boolean  @default(false) @map("has_spoilers")
  isVerifiedBuyer Boolean  @default(false) @map("is_verified_buyer")
  likesCount      Int      @default(0) @map("likes_count")
  isApproved      Boolean  @default(true) @map("is_approved")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  movie           Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking         Booking? @relation(fields: [bookingId], references: [id])
  likes           ReviewLike[]

  @@unique([movieId, userId])
  @@map("movie_reviews")
}

model ReviewLike {
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  review    MovieReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@map("review_likes")
}

model MovieWatchlist {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  movieId          String   @map("movie_id")
  notifyOnPresale  Boolean  @default(true) @map("notify_on_presale")
  isNotified       Boolean  @default(false) @map("is_notified")
  createdAt        DateTime @default(now()) @map("created_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie            Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("movie_watchlists")
}

model GroupBooking {
  id                String   @id @default(uuid())
  leaderUserId      String   @map("leader_user_id")
  showtimeId        String   @map("showtime_id")
  groupName         String   @default("Xem Phim Cùng Bạn Bè") @map("group_name")
  inviteCode        String   @unique @map("invite_code")
  totalSeatsTarget  Int      @default(2) @map("total_seats_target")
  status            String   @default("ORGANIZING") // ORGANIZING, COMPLETED, EXPIRED
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  leader            User     @relation("GroupLeader", fields: [leaderUserId], references: [id], onDelete: Cascade)
  showtime          Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  members           GroupBookingMember[]

  @@map("group_bookings")
}

model GroupBookingMember {
  id             String        @id @default(uuid())
  groupBookingId String        @map("group_booking_id")
  userId         String?       @map("user_id")
  guestName      String?       @map("guest_name")
  showtimeSeatId String?       @map("showtime_seat_id")
  hasPaid        Boolean       @default(false) @map("has_paid")
  createdAt      DateTime      @default(now()) @map("created_at")

  groupBooking   GroupBooking  @relation(fields: [groupBookingId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id])
  showtimeSeat   ShowtimeSeat? @relation(fields: [showtimeSeatId], references: [id])

  @@map("group_booking_members")
}

model WaitingRoomSession {
  id           String    @id @default(uuid())
  showtimeId   String    @map("showtime_id")
  userIp       String    @map("user_ip")
  sessionToken String    @unique @map("session_token")
  queueNumber  Int       @map("queue_number")
  status       String    @default("WAITING") // WAITING, ADMITTED, EXPIRED
  admittedAt   DateTime? @map("admitted_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  showtime     Showtime  @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  @@map("waiting_room_sessions")
}
