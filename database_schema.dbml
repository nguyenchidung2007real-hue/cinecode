// ==============================================================================
// CINEMAX - ENTERPRISE DATABASE SCHEMA (DBML)
// PHIÊN BẢN: 3.1 - ĐÃ BỔ SUNG GIẢI THÍCH NHẸ CHO TỪNG BẢNG & TỪNG CỘT
// Hướng dẫn xem: Copy toàn bộ nội dung tệp này dán vào https://dbdiagram.io/
// ==============================================================================

Project Cinema_Booking_System {
  database_type: 'PostgreSQL'
  Note: '''
    # Nền tảng CineMax - Enterprise Architecture (29 Bảng)
    Mỗi bảng đều có ghi chú giải thích nhẹ vai trò thực tế đời sống:
    - Nhóm 1: Địa điểm & Rạp (cinemas, halls, seat_templates)
    - Nhóm 2: Phim & Lịch chiếu (genres, movies, movie_genres, showtimes, showtime_seats)
    - Nhóm 3: Người dùng, Vé & Đơn hàng (users, bookings, tickets)
    - Nhóm 4: Bắp nước F&B (concessions, booking_concessions, concession_deliveries)
    - Nhóm 5: Thanh toán & An ninh (payments, system_audit_logs, refund_requests)
    - Nhóm 6: Thành viên & Khuyến mãi (membership_tiers, user_loyalty_transactions, coupons, coupon_redemptions, gift_cards, gift_card_transactions)
    - Nhóm 7: Cộng đồng & Mở rộng (movie_reviews, review_likes, movie_watchlists, group_bookings, group_booking_members, waiting_room_sessions)
  '''
}

// ==============================================================================
// NHÓM 1: ĐỊA ĐIỂM, PHÒNG CHIẾU & GHẾ VẬT LÝ (3 BẢNG)
// ==============================================================================

Table cinemas {
  Note: '💡 [BẢNG 1 - RẠP PHIM]: Lưu danh sách các cụm rạp trong chuỗi (CGV, Galaxy, Lotte...). Giúp khách hàng tìm rạp gần nhất qua GPS.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Số CCCD duy nhất của rạp']
  name varchar(150) [not null, note: 'Tên cụm rạp ngoài đời (CGV Landmark 81, Galaxy Nguyễn Du)']
  slug varchar(180) [unique, not null, note: 'Tên viết liền không dấu làm link web (/rap/cgv-landmark-81)']
  address varchar(255) [not null, note: 'Địa chỉ số nhà, tên đường của rạp']
  ward varchar(100) [note: 'Phường / Xã']
  district varchar(100) [not null, note: 'Quận / Huyện để khách lọc rạp']
  city varchar(100) [not null, note: 'Tỉnh / Thành phố (Hà Nội, TP.HCM, Huế...)']
  latitude decimal(10,7) [note: 'Tọa độ vĩ độ GPS để mở Google Maps']
  longitude decimal(10,7) [note: 'Tọa độ kinh độ GPS để định vị khoảng cách']
  phone varchar(25) [note: 'Hotline liên hệ chăm sóc khách hàng']
  amenities jsonb [note: 'Danh sách tiện ích: Bãi đỗ ô tô, Máy lạnh, Quầy bắp rang...']
  is_active boolean [default: true, note: 'Rạp còn mở cửa đón khách (True) hay đang sửa chữa (False)']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table halls {
  Note: '💡 [BẢNG 2 - PHÒNG CHIẾU]: Quản lý các phòng chiếu trong rạp (Phòng 01, IMAX, 4DX). Một rạp có nhiều phòng.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã số định danh của phòng chiếu']
  cinema_id uuid [not null, ref: > cinemas.id, note: 'Dây nối: Phòng này nằm trong rạp nào?']
  name varchar(50) [not null, note: 'Tên phòng ngoài đời (Phòng IMAX 01, Phòng 02, Cinema 03)']
  hall_type varchar(30) [not null, note: 'Công nghệ chiếu: STANDARD_2D, DIGITAL_3D, IMAX_LASER, FOUR_DX, SCREEN_X']
  sound_system varchar(50) [default: 'Dolby Atmos 7.1', note: 'Hệ thống âm thanh vòm của phòng']
  projector_type varchar(50) [default: 'Christie 4K Laser', note: 'Loại máy chiếu laser hoặc kỹ thuật số']
  total_seats int [not null, note: 'Sức chứa tối đa (ví dụ 108 ghế)']
  rows_count int [not null, note: 'Phòng có bao nhiêu hàng ghế (để vẽ sơ đồ)']
  cols_count int [not null, note: 'Phòng có bao nhiêu cột ghế (để vẽ sơ đồ)']
  is_active boolean [default: true, note: 'Phòng đang hoạt động hay tạm đóng bảo trì']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table seat_templates {
  Note: '💡 [BẢNG 3 - MẪU GHẾ CỐ ĐỊNH]: Sơ đồ ghế vật lý bắt ốc vít cố định trong phòng chiếu. Vẽ 1 lần dùng mãi mãi.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã số định danh của vị trí ghế']
  hall_id uuid [not null, ref: > halls.id, note: 'Dây nối: Chiếc ghế này bắt ở phòng nào?']
  row_code varchar(5) [not null, note: 'Tên hàng ghế (Hàng A, B, C, D, E, F...)']
  seat_number int [not null, note: 'Số thứ tự ghế trong hàng (1, 2, 3... 12)']
  seat_type varchar(30) [not null, note: 'Phân loại ghế: STANDARD (thường), VIP (giữa phòng), SWEETBOX (ghế đôi), AISLE (lối đi)']
  coord_x int [not null, note: 'Tọa độ X trên màn hình để máy tính biết chỗ vẽ']
  coord_y int [not null, note: 'Tọa độ Y trên màn hình để máy tính biết chỗ vẽ']
  is_active boolean [default: true, note: 'Ghế còn tốt hay bị hỏng hóc cần khóa']
  created_at timestamp [default: `now()`]
}

// ==============================================================================
// NHÓM 2: PHIM, THỂ LOẠI & LỊCH SUẤT CHIẾU (5 BẢNG)
// ==============================================================================

Table genres {
  Note: '💡 [BẢNG 4 - THỂ LOẠI]: Danh mục phân loại phim (Hành động, Viễn tưởng, Hoạt hình, Kinh dị...)'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã thể loại']
  name varchar(80) [unique, not null, note: 'Tên thể loại hiển thị']
  slug varchar(100) [unique, not null, note: 'Link web lọc phim theo thể loại (/the-loai/hanh-dong)']
  description text [note: 'Mô tả đặc trưng của thể loại phim']
  created_at timestamp [default: `now()`]
}

Table movies {
  Note: '💡 [BẢNG 5 - KHO PHIM]: Thông tin chi tiết các bộ phim nhập về chiếu tại rạp.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã số định danh của phim']
  title varchar(255) [not null, note: 'Tên phim phát hành tại Việt Nam (Dune: Phần Hai, Lật Mặt 7)']
  original_title varchar(255) [note: 'Tên gốc tiếng Anh/quốc tế (Dune: Part Two)']
  slug varchar(280) [unique, not null, note: 'Link web xem chi tiết phim (/phim/dune-phan-hai)']
  overview text [note: 'Tóm tắt nội dung cốt truyện của phim']
  poster_url text [not null, note: 'Link ảnh áp phích dọc của phim']
  backdrop_url text [note: 'Link ảnh banner ngang khổ lớn làm hình nền']
  trailer_youtube_id varchar(50) [note: 'Mã đuôi video YouTube để bấm phát trailer trên web']
  duration_min int [not null, note: 'Thời lượng phim tính bằng phút (rất quan trọng để tính giờ hết phim)']
  release_date date [not null, note: 'Ngày công chiếu mở màn tại rạp']
  end_date date [note: 'Ngày dự kiến ngưng chiếu']
  age_rating varchar(10) [not null, note: 'Nhãn dán độ tuổi: P (mọi người), K (dưới 13 đi cùng bố mẹ), T13, T16, T18, C (cấm chiếu)']
  director varchar(150) [note: 'Tên đạo diễn']
  cast_members "text[]" [note: 'Danh sách diễn viên chính']
  producer varchar(150) [note: 'Hãng sản xuất phim (Warner Bros, Marvel...)']
  country varchar(80) [default: 'Việt Nam', note: 'Quốc gia sản xuất']
  rating_average decimal(3,1) [default: 0.0, note: 'Điểm số đánh giá trung bình từ 1-10 sao (tự động tính)']
  rating_count int [default: 0, note: 'Tổng số lượt khán giả đã chấm điểm']
  status varchar(20) [default: 'NOW_SHOWING', note: 'Đèn báo phim: NOW_SHOWING (đang chiếu), COMING_SOON (sắp chiếu), SNEAK_SHOW (chiếu sớm), ENDED (hết chiếu)']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table movie_genres {
  Note: '💡 [BẢNG 6 - NỐI PHIM & THỂ LOẠI]: Bảng cầu nối N:M. Một phim có thể vừa là Hành động vừa là Viễn tưởng.'
  movie_id uuid [ref: > movies.id, note: 'Phim nào?']
  genre_id uuid [ref: > genres.id, note: 'Thuộc thể loại nào?']
  indexes {
    (movie_id, genre_id) [pk]
  }
}

Table showtimes {
  Note: '💡 [BẢNG 7 - LỊCH SUẤT CHIẾU]: Xếp lịch chiếu một phim tại một phòng vào một giờ cụ thể.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã định danh của suất chiếu']
  movie_id uuid [not null, ref: > movies.id, note: 'Chiếu phim gì?']
  hall_id uuid [not null, ref: > halls.id, note: 'Chiếu ở phòng nào?']
  start_time timestamp [not null, note: 'Mấy giờ bắt đầu chiếu (ví dụ 18h30)']
  end_time timestamp [not null, note: 'Mấy giờ hết phim (tự tính: giờ bắt đầu + thời lượng phim + 15p dọn rạp)']
  format varchar(40) [default: '2D Phụ Đề', note: 'Định dạng suất chiếu: 2D Phụ Đề, 3D Lồng Tiếng, IMAX Laser']
  base_price decimal(12,2) [not null, note: 'Giá vé cơ sở của suất đó (buổi sáng rẻ hơn buổi tối cuối tuần)']
  status varchar(20) [default: 'SCHEDULED', note: 'Trạng thái: SCHEDULED (lên lịch), OPEN_BOOKING (đang mở bán), FINISHED (đã chiếu xong)']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table showtime_seats {
  Note: '💡 [BẢNG 8 - TRẠNG THÁI GHẾ ĐỘNG]: ⭐ BẢNG THEN CHỐT. Cùng ghế F7 nhưng suất 18h đã bán, suất 20h còn trống. Bảng này quản lý ghế theo từng giờ.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã định danh trạng thái ghế trong suất chiếu']
  showtime_id uuid [not null, ref: > showtimes.id, note: 'Thuộc suất chiếu nào?']
  seat_template_id uuid [not null, ref: > seat_templates.id, note: 'Ánh xạ đến ghế vật lý nào trong phòng?']
  status varchar(20) [default: 'AVAILABLE', note: 'Đèn giao thông: AVAILABLE (trắng/trống), HOLD (vàng/đang giữ 10p), BOOKED (đỏ/đã bán)']
  price decimal(12,2) [not null, note: 'Giá vé thực tế của ghế đó (ghế VIP cộng thêm 25k, ghế đôi nhân 2)']
  reserved_by_user_id uuid [note: 'Khách hàng nào đang tạm giữ ghế này']
  reservation_expires_at timestamp [note: 'Đồng hồ đếm ngược 10 phút. Hết giờ tự nhả ghế về AVAILABLE']
  version int [default: 1, note: 'Khóa chống tranh chấp (Optimistic Lock). 2 người bấm cùng lúc thì người sau bị chặn']
  updated_at timestamp [default: `now()`]
  indexes {
    (showtime_id, seat_template_id) [unique]
  }
}

// ==============================================================================
// NHÓM 3: NGƯỜI DÙNG, ĐƠN ĐẶT VÉ & VÉ ĐIỆN TỬ (3 BẢNG)
// ==============================================================================

Table users {
  Note: '💡 [BẢNG 9 - TÀI KHOẢN]: Quản lý tất cả tài khoản trong hệ thống (Khách hàng, Nhân viên, Quản lý, Admin).'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Số CCCD tài khoản duy nhất']
  full_name varchar(120) [not null, note: 'Họ và tên người dùng']
  email varchar(120) [unique, not null, note: 'Email dùng để đăng nhập và nhận vé']
  phone varchar(25) [unique, note: 'Số điện thoại nhận tin nhắn SMS mã vé']
  password_hash varchar(255) [note: 'Mật khẩu đã mã hóa Bcrypt bí mật chống hack']
  role varchar(20) [default: 'CUSTOMER', note: 'Phân quyền: CUSTOMER (khách), STAFF (soát vé), CINEMA_MANAGER (quản lý rạp), SUPER_ADMIN (admin)']
  avatar_url text [note: 'Link ảnh đại diện']
  loyalty_points int [default: 0, note: 'Tổng số điểm thưởng tích lũy trong ví']
  is_active boolean [default: true, note: 'Tài khoản đang hoạt động hay bị khóa']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table bookings {
  Note: '💡 [BẢNG 10 - ĐƠN ĐẶT VÉ]: Hóa đơn tổng của một lần mua vé (chứa mã đơn, tổng tiền, trạng thái thanh toán).'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã số hóa đơn trong database']
  booking_code varchar(50) [unique, not null, note: 'Mã đơn hàng ngắn gọn để khách đọc cho nhân viên (CINE-20261010-VIP99)']
  user_id uuid [not null, ref: > users.id, note: 'Khách hàng nào là người mua?']
  showtime_id uuid [not null, ref: > showtimes.id, note: 'Mua vé xem suất chiếu nào?']
  total_amount decimal(12,2) [not null, note: 'Tổng tiền gốc (tiền vé + tiền bắp nước)']
  discount_amount decimal(12,2) [default: 0, note: 'Số tiền được giảm giá bằng voucher hoặc điểm']
  final_amount decimal(12,2) [not null, note: 'Số tiền thực tế khách phải quẹt thẻ trả']
  payment_status varchar(20) [default: 'PENDING', note: 'Trạng thái tiền: PENDING (chờ trả), PAID (đã trả xong), EXPIRED (hết hạn), REFUNDED (đã hoàn lại)']
  idempotency_key varchar(100) [unique, not null, note: '⭐ Khóa chống trừ tiền 2 lần khi khách sốt ruột bấm nút thanh toán nhiều lần']
  customer_notes text [note: 'Ghi chú thêm của khách']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table tickets {
  Note: '💡 [BẢNG 11 - VÉ ĐIỆN TỬ CHI TIẾT]: Một đơn mua 3 ghế thì in ra 3 vé. Mỗi vé có mã QR riêng để quét qua cửa rạp.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã định danh chiếc vé']
  booking_id uuid [not null, ref: > bookings.id, note: 'Chiếc vé này thuộc đơn đặt vé nào?']
  showtime_seat_id uuid [unique, not null, ref: - showtime_seats.id, note: 'Quan hệ 1:1 - Chiếc vé này dành riêng cho vị trí ghế nào trong suất?']
  ticket_code varchar(60) [unique, not null, note: 'Mã số vé in trên thẻ (TK-20261010-F6)']
  qr_code_payload text [not null, note: 'Dữ liệu bí mật mã hóa JWT được vẽ thành hình ô vuông mã QR trên điện thoại']
  is_checked_in boolean [default: false, note: 'Khách đã quét vé vào rạp chưa (False: chưa vào; True: đã vào trong phòng)']
  checked_in_at timestamp [note: 'Mấy giờ khách bước qua cửa rạp']
  checked_in_by_staff_id uuid [ref: > users.id, note: 'Bạn nhân viên soát vé nào đã soi đèn quét mã QR này']
  created_at timestamp [default: `now()`]
}

// ==============================================================================
// NHÓM 4: BẮP NƯỚC F&B & GIAO TẬN GHẾ (3 BẢNG)
// ==============================================================================

Table concessions {
  Note: '💡 [BẢNG 12 - MENU BẮP NƯỚC]: Danh mục đồ ăn thức uống bán tại quầy F&B của rạp (Bắp ngọt, bắp phô mai, Coca, snack).'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã món ăn/nước uống']
  cinema_id uuid [not null, ref: > cinemas.id, note: 'Menu này của cụm rạp nào?']
  name varchar(120) [not null, note: 'Tên món: Combo Solo Bắp Ngọt, Combo Couple Đôi Bạn']
  category varchar(50) [default: 'COMBO', note: 'Phân loại: COMBO, POPCORN (bắp), BEVERAGE (nước), SNACK (đồ ăn vặt)']
  description text [note: 'Mô tả thành phần: 1 bắp phô mai lớn + 2 nước ngọt']
  price decimal(12,2) [not null, note: 'Đơn giá bán']
  image_url text [note: 'Hình ảnh ly bắp nước ngon mắt trên web']
  is_active boolean [default: true, note: 'Món này còn bán hay tạm hết hàng']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table booking_concessions {
  Note: '💡 [BẢNG 13 - CHI TIẾT BẮP NƯỚC ĐƠN]: Lưu khách mua kèm những món bắp nước nào trong đơn đặt vé.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã chi tiết món']
  booking_id uuid [not null, ref: > bookings.id, note: 'Thuộc đơn đặt vé nào?']
  concession_id uuid [not null, ref: > concessions.id, note: 'Món bắp nước nào?']
  quantity int [not null, note: 'Khách mua mấy phần (ví dụ 2 combo)']
  unit_price decimal(12,2) [not null, note: 'Giá tiền 1 phần lúc mua']
  subtotal decimal(12,2) [not null, note: 'Thành tiền = số lượng nhân đơn giá']
  created_at timestamp [default: `now()`]
}

Table concession_deliveries {
  Note: '💡 [BẢNG 14 - GIAO BẮP TẬN GHẾ]: Khách lười xếp hàng ở quầy, chọn dịch vụ nhân viên bưng bắp nước tới tận ghế ngồi trước giờ chiếu.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã đơn giao bắp nước']
  booking_id uuid [not null, ref: > bookings.id, note: 'Giao cho đơn vé nào?']
  delivery_type varchar(30) [default: 'EXPRESS_COUNTER', note: 'Hình thức nhận: EXPRESS_COUNTER (ra quầy ưu tiên lấy), AT_SEAT_DELIVERY (giao tận ghế)']
  seat_location varchar(20) [note: 'Địa chỉ giao hàng trong rạp: Ghế F7 - Phòng IMAX 01']
  estimated_delivery_time timestamp [note: 'Giờ dự kiến giao (trước giờ chiếu 5-10 phút)']
  delivery_status varchar(30) [default: 'PREPARING', note: 'Trạng thái: PREPARING (đang làm bắp), DELIVERED (đã giao tận tay cho khách)']
  delivered_by_staff_id uuid [ref: > users.id, note: 'Bạn nhân viên nào phụ trách mang bắp tới']
  created_at timestamp [default: `now()`]
}

// ==============================================================================
// NHÓM 5: THANH TOÁN, KIỂM TOÁN AN NINH & HOÀN TIỀN (3 BẢNG)
// ==============================================================================

Table payments {
  Note: '💡 [BẢNG 15 - LỊCH SỬ THANH TOÁN]: Lưu vết dòng tiền chuyển khoản qua ví MoMo, VNPay, ZaloPay để đối soát ngân hàng.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã giao dịch nội bộ']
  booking_id uuid [not null, ref: > bookings.id, note: 'Thanh toán cho đơn vé nào?']
  gateway varchar(30) [not null, note: 'Kênh thanh toán: MOMO, VNPAY, ZALOPAY, STRIPE']
  gateway_transaction_id varchar(100) [note: 'Mã giao dịch do phía ngân hàng/MoMo cấp để tra soát']
  amount decimal(12,2) [not null, note: 'Số tiền thực chuyển']
  currency varchar(10) [default: 'VND', note: 'Loại tiền tệ']
  status varchar(30) [not null, note: 'Trạng thái giao dịch: SUCCESS (thành công), FAILED (thất bại)']
  webhook_payload jsonb [note: 'Gói tin bằng chứng gốc từ ngân hàng gửi về']
  created_at timestamp [default: `now()`]
}

Table system_audit_logs {
  Note: '💡 [BẢNG 16 - NHẬT KÝ KIỂM TOÁN / CAMERA HỆ THỐNG]: Ghi lại mọi hành động nhạy cảm của nhân viên để chống gian lận và điều tra an ninh.'
  id bigserial [pk, note: 'Số thứ tự nhật ký tăng tự động']
  user_id uuid [ref: > users.id, note: 'Ai là người thao tác (nhân viên A hay admin B)?']
  action varchar(80) [not null, note: 'Hành động gì: LOGIN (đăng nhập), UPDATE_PRICE (đổi giá vé), CANCEL_TICKET (hủy vé)']
  resource_type varchar(50) [not null, note: 'Loại đối tượng bị sửa: showtimes, tickets, users']
  resource_id varchar(100) [not null, note: 'Mã ID của đối tượng bị can thiệp']
  ip_address varchar(45) [note: 'Địa chỉ mạng IP của máy tính thực hiện']
  user_agent text [note: 'Trình duyệt và thiết bị của người dùng']
  metadata jsonb [note: 'Dữ liệu trước và sau khi bị sửa đổi']
  created_at timestamp [default: `now()`]
}

Table refund_requests {
  Note: '💡 [BẢNG 17 - YÊU CẦU HOÀN TIỀN]: Cho phép khách gửi yêu cầu trả vé hoàn tiền trước giờ chiếu 60 phút khi bận việc đột xuất.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã phiếu xin hoàn vé']
  booking_id uuid [not null, ref: > bookings.id, note: 'Đơn vé nào muốn hủy?']
  user_id uuid [not null, ref: > users.id, note: 'Khách hàng nào gửi yêu cầu?']
  reason text [not null, note: 'Lý do xin hoàn vé (đột xuất bị ốm, có việc gia đình...)']
  original_amount decimal(12,2) [not null, note: 'Tiền vé gốc ban đầu (ví dụ 200k)']
  refund_amount decimal(12,2) [not null, note: 'Tiền thực tế chuyển trả lại cho khách (160k)']
  penalty_fee decimal(12,2) [default: 0, note: 'Phí phạt hủy vé nếu có (ví dụ trừ phí 20% = 40k)']
  status varchar(20) [default: 'PENDING', note: 'Trạng thái: PENDING (chờ duyệt), APPROVED (đồng ý), REJECTED (từ chối), PROCESSED (tiền đã về tài khoản)']
  processed_by_staff_id uuid [ref: > users.id, note: 'Quản lý rạp nào đã bấm duyệt hoàn tiền']
  processed_at timestamp [note: 'Thời điểm duyệt hoàn tiền']
  bank_account_info jsonb [note: 'Số tài khoản ngân hàng của khách để rạp chuyển tiền trả lại']
  created_at timestamp [default: `now()`]
}

// ==============================================================================
// NHÓM 6: THÀNH VIÊN, VOUCHER & THẺ QUÀ TẶNG (6 BẢNG)
// ==============================================================================

Table membership_tiers {
  Note: '💡 [BẢNG 18 - HẠNG THÀNH VIÊN]: Quản lý cấp bậc hội viên (Đồng, Bạc, Vàng, Kim Cương) để tặng quyền lợi cho khách quen.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã hạng thành viên']
  tier_name varchar(50) [unique, not null, note: 'Tên cấp bậc: Bronze (Đồng), Silver (Bạc), Gold (Vàng), Diamond (Kim Cương)']
  min_spending decimal(12,2) [default: 0, note: 'Năm nay phải chi tiêu bao nhiêu tiền thì được lên hạng này (2 triệu, 5 triệu...)']
  point_multiplier decimal(3,2) [default: 1.0, note: 'Hệ số nhân điểm thưởng (khách thường 1.0x, khách Vàng nhân 1.5x, Kim Cương nhân 2.0x)']
  benefits jsonb [note: 'Mảng JSON danh sách quyền lợi: Tặng vé sinh nhật, Lối đi ưu tiên...']
  badge_color varchar(20) [default: '#94a3b8', note: 'Màu huy hiệu gắn trên app (vàng ánh kim, bạc)']
  created_at timestamp [default: `now()`]
}

Table user_loyalty_transactions {
  Note: '💡 [BẢNG 19 - SỔ CÁI ĐIỂM THƯỞNG]: Sổ ghi chép từng lần cộng / trừ điểm như sao kê ngân hàng, minh bạch và chống hack điểm.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã giao dịch điểm']
  user_id uuid [not null, ref: > users.id, note: 'Khách hàng nào?']
  booking_id uuid [ref: > bookings.id, note: 'Điểm này sinh ra từ đơn vé nào?']
  points_delta int [not null, note: 'Số điểm tăng (+) hoặc giảm (-): ví dụ +50 khi mua vé, -100 khi đổi hộp bắp']
  transaction_type varchar(50) [not null, note: 'Lý do biến động: BOOKING_EARN (mua vé được thưởng), REDEEM_DISCOUNT (tiêu điểm đổi quà), EXPIRED (điểm hết hạn)']
  description text [note: 'Lời giải thích dễ hiểu (Tích điểm từ đơn hàng CINE-9988)']
  created_at timestamp [default: `now()`]
}

Table coupons {
  Note: '💡 [BẢNG 20 - MÃ GIẢM GIÁ / VOUCHER]: Quản lý các chương trình khuyến mãi (ví dụ mã CINEMAX2026 giảm 20%).'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã voucher']
  code varchar(50) [unique, not null, note: 'Mã chữ nhập lúc thanh toán (CINEMAX2026, SINHVIEN20K)']
  description text [note: 'Mô tả điều kiện: Giảm 20% tối đa 50k cho đơn vé đầu tiên']
  discount_type varchar(20) [not null, note: 'Kiểu giảm giá: PERCENTAGE (giảm theo %), FIXED_AMOUNT (giảm số tiền cố định)']
  discount_value decimal(12,2) [not null, note: 'Giá trị giảm (ví dụ 20% hoặc 50.000đ)']
  min_order_amount decimal(12,2) [default: 0, note: 'Đơn hàng tối thiểu bao nhiêu tiền mới được áp mã']
  max_discount_amount decimal(12,2) [note: 'Giảm tối đa bao nhiêu tiền']
  total_usage_limit int [note: 'Giới hạn cả rạp chỉ có 1000 lượt dùng']
  current_usage_count int [default: 0, note: 'Đã có bao nhiêu người nhập mã này rồi']
  per_user_limit int [default: 1, note: 'Mỗi khách chỉ được dùng mã này mấy lần (mặc định 1 lần)']
  valid_from timestamp [not null, note: 'Mã có hiệu lực từ ngày nào']
  valid_to timestamp [not null, note: 'Hạn chót hết hạn của mã']
  is_active boolean [default: true, note: 'Mã còn kích hoạt hay đã tạm dừng']
  created_at timestamp [default: `now()`]
}

Table coupon_redemptions {
  Note: '💡 [BẢNG 21 - LỊCH SỬ DÙNG VOUCHER]: Lưu vết ai đã dùng mã nào, vào đơn nào để chặn việc một người dùng lậu 10 lần.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã ghi nhận lượt dùng voucher']
  coupon_id uuid [not null, ref: > coupons.id, note: 'Mã voucher nào đã bị dùng?']
  user_id uuid [not null, ref: > users.id, note: 'Khách hàng nào đã dùng?']
  booking_id uuid [not null, ref: > bookings.id, note: 'Dùng cho đơn vé nào?']
  discount_applied decimal(12,2) [not null, note: 'Đơn này được bớt thực tế bao nhiêu tiền']
  redeemed_at timestamp [default: `now()`, note: 'Thời điểm nhập mã']
}

Table gift_cards {
  Note: '💡 [BẢNG 22 - THẺ QUÀ TẶNG / VÍ ĐIỆN TỬ]: Khách mua thẻ nạp sẵn 500k để gửi tặng sinh nhật bạn bè qua email kèm lời chúc.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã thẻ quà tặng']
  card_code varchar(30) [unique, not null, note: 'Dãy số thẻ cào quà tặng (GIFT-2026-HAPPY)']
  pin_hash varchar(255) [not null, note: 'Mã PIN bảo mật của thẻ (phải nhập đúng mã PIN mới được quẹt)']
  initial_balance decimal(12,2) [not null, note: 'Mệnh giá ban đầu lúc mua thẻ (500.000đ)']
  current_balance decimal(12,2) [not null, note: 'Số dư tiền còn lại trong thẻ sau khi đã mua vé nhiều lần']
  sender_user_id uuid [ref: > users.id, note: 'Ai là người mua tặng chiếc thẻ này?']
  recipient_email varchar(120) [note: 'Email của người bạn được tặng nhận thẻ']
  greeting_message text [note: 'Lời chúc gửi kèm: Chúc mừng sinh nhật, xem phim vui vẻ nhé!']
  is_active boolean [default: true, note: 'Thẻ còn hoạt động hay bị khóa']
  expires_at timestamp [not null, note: 'Hạn sử dụng của thẻ quà tặng (thường 1 năm)']
  created_at timestamp [default: `now()`]
}

Table gift_card_transactions {
  Note: '💡 [BẢNG 23 - LỊCH SỬ TRỪ TIỀN THẺ QUÀ TẶNG]: Quản lý lịch sử quẹt thẻ quà tặng để mua vé và số dư còn lại sau mỗi lần trừ.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã giao dịch quẹt thẻ']
  gift_card_id uuid [not null, ref: > gift_cards.id, note: 'Chiếc thẻ nào bị quẹt trừ tiền?']
  booking_id uuid [ref: > bookings.id, note: 'Trừ tiền để mua đơn vé nào?']
  amount_deducted decimal(12,2) [not null, note: 'Lần này quẹt trừ bao nhiêu tiền (trừ 160k)']
  remaining_balance decimal(12,2) [not null, note: 'Số dư còn lại trong thẻ sau khi quẹt (còn 340k)']
  created_at timestamp [default: `now()`]
}

// ==============================================================================
// NHÓM 7: REVIEW, NHÓM XEM, THEO DÕI & PHÒNG CHỜ ẢO (6 BẢNG)
// ==============================================================================

Table movie_reviews {
  Note: '💡 [BẢNG 24 - ĐÁNH GIÁ PHIM]: Khán giả chấm điểm và viết cảm nhận. Có cờ Verified Buyer xác thực người đã mua vé thật.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã bài đánh giá']
  movie_id uuid [not null, ref: > movies.id, note: 'Đánh giá bộ phim nào?']
  user_id uuid [not null, ref: > users.id, note: 'Ai là người viết review?']
  booking_id uuid [ref: > bookings.id, note: '⭐ Chiếc vé làm bằng chứng: Có mua vé thật tại rạp thì được gắn tick xanh Đã xem tại rạp']
  rating_score int [not null, note: 'Điểm chấm từ 1 đến 10 sao']
  title varchar(150) [note: 'Tiêu đề ngắn gọn của bài đánh giá']
  content text [note: 'Nội dung nhận xét chi tiết khen hay hoặc chê dở']
  has_spoilers boolean [default: false, note: 'Cờ cảnh báo bài có kể trước kết phim (để web làm mờ nội dung)']
  is_verified_buyer boolean [default: false, note: 'Tick xanh xác thực người mua vé thật']
  likes_count int [default: 0, note: 'Số lượt người khác bấm thích bài viết này']
  is_approved boolean [default: true, note: 'Đã được duyệt xuất bản lên trang chủ']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  indexes {
    (movie_id, user_id) [unique]
  }
}

Table review_likes {
  Note: '💡 [BẢNG 25 - LƯỢT THÍCH REVIEW]: Quản lý việc người xem bấm Thả tim các bài review hay. Mỗi người chỉ được bấm 1 lần.'
  review_id uuid [not null, ref: > movie_reviews.id, note: 'Bài review nào được thích?']
  user_id uuid [not null, ref: > users.id, note: 'Ai là người bấm nút thích?']
  created_at timestamp [default: `now()`]
  indexes {
    (review_id, user_id) [pk]
  }
}

Table movie_watchlists {
  Note: '💡 [BẢNG 26 - THEO DÕI PHIM SẮP CHIẾU]: Khán giả bấm chuông theo dõi phim bom tấn sắp ra rạp (ví dụ Avatar 3) để nhận email báo mở bán vé sớm.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã theo dõi']
  user_id uuid [not null, ref: > users.id, note: 'Khách hàng nào bấm theo dõi?']
  movie_id uuid [not null, ref: > movies.id, note: 'Đang theo dõi bộ phim nào?']
  notify_on_presale boolean [default: true, note: 'Có muốn nhận thông báo khi có vé mở bán sớm không (True/False)']
  is_notified boolean [default: false, note: 'Hệ thống đã gửi thông báo cho bạn này chưa (True = đã gửi, không gửi trùng lặp)']
  created_at timestamp [default: `now()`]
  indexes {
    (user_id, movie_id) [unique]
  }
}

Table group_bookings {
  Note: '💡 [BẢNG 27 - ĐẶT VÉ THEO NHÓM]: Tính năng rủ bạn bè đi xem chung: Trưởng nhóm tạo phòng, gửi link qua Zalo để cả nhóm tự chọn ghế và tự chia tiền vé.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã phòng nhóm xem phim']
  leader_user_id uuid [not null, ref: > users.id, note: 'Bạn trưởng nhóm (người đứng ra tạo phòng rủ rê)']
  showtime_id uuid [not null, ref: > showtimes.id, note: 'Cả nhóm định đi xem suất chiếu nào?']
  group_name varchar(100) [default: 'Xem Phim Cùng Bạn Bè', note: 'Tên nhóm (ví dụ: Hội bạn thân xem Dune 2)']
  invite_code varchar(20) [unique, not null, note: 'Mã link mời gửi qua Zalo/Messenger cho bạn bè cùng bấm vào']
  total_seats_target int [not null, default: 2, note: 'Mục tiêu nhóm định rủ mấy người (ví dụ nhóm 4 người)']
  status varchar(30) [default: 'ORGANIZING', note: 'Trạng thái: ORGANIZING (đang gom bạn bè), COMPLETED (đã mua xong đủ vé), EXPIRED (quá giờ)']
  expires_at timestamp [not null, note: 'Hạn chót của phòng (sau 2 tiếng không mua đủ thì phòng tự giải tán)']
  created_at timestamp [default: `now()`]
}

Table group_booking_members {
  Note: '💡 [BẢNG 28 - THÀNH VIÊN NHÓM XEM]: Danh sách từng người bạn tham gia vào phòng nhóm xem phim ở trên.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã thành viên tham gia nhóm']
  group_booking_id uuid [not null, ref: > group_bookings.id, note: 'Thuộc phòng nhóm nào?']
  user_id uuid [ref: > users.id, note: 'Tài khoản người bạn tham gia nhóm']
  guest_name varchar(100) [note: 'Tên bạn bè hiển thị (bạn Nam, bạn Lan)']
  showtime_seat_id uuid [ref: > showtime_seats.id, note: 'Bạn này đã tự chọn cho mình chiếc ghế nào trong rạp']
  has_paid boolean [default: false, note: 'Bạn này đã tự trả tiền vé phần của mình chưa (True: đã trả; False: chưa trả)']
  created_at timestamp [default: `now()`]
}

Table waiting_room_sessions {
  Note: '💡 [BẢNG 29 - PHÒNG CHỜ ẢO CHỐNG SẬP WEB]: Khi phim siêu hot mở bán có 100.000 người ùa vào, hệ thống xếp hàng ảo từng đợt để server không bị sập.'
  id uuid [pk, default: `gen_random_uuid()`, note: 'Mã phiên xếp hàng']
  showtime_id uuid [not null, ref: > showtimes.id, note: 'Suất chiếu bom tấn đang bị quá tải']
  user_ip varchar(45) [not null, note: 'Địa chỉ mạng IP của người đang xếp hàng']
  session_token varchar(100) [unique, not null, note: 'Chiếc vé thông hành cho phép vào chọn ghế trong 5 phút khi đến lượt']
  queue_number int [not null, note: 'Số thứ tự xếp hàng (bạn là người số 150)']
  status varchar(20) [default: 'WAITING', note: 'Trạng thái: WAITING (đang chờ), ADMITTED (đã đến lượt vào đặt vé), EXPIRED (quá giờ giữ chỗ)']
  admitted_at timestamp [note: 'Mấy giờ được hệ thống mở cửa cho vào mua vé']
  expires_at timestamp [not null, note: 'Hạn chót 5 phút mua vé của phiên']
  created_at timestamp [default: `now()`]
}
