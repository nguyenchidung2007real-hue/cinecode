<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-10-07T00:00:00.000Z" agent="Antigravity CineMax" version="21.0.0" type="device">
  <diagram id="CineMax-ERD-29-Tables" name="CineMax 29 Tables ERD">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="table_1" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#047857;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#1. cinemas&lt;/b&gt; (Cụm Rạp Chiếu Phim Ngoài Đời)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Lưu danh sách các chi nhánh rạp trong chuỗi (CGV, Galaxy, Lotte...). Giúp khách tìm rạp gần nhất qua GPS và xem tiện ích bãi đỗ xe.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• name (Tên rạp)&lt;br/&gt;• slug (Đường dẫn web)&lt;br/&gt;• address (Địa chỉ)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_2" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#047857;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#2. halls&lt;/b&gt; (Phòng Chiếu Trong Rạp)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Quản lý các phòng chiếu trong rạp (Phòng 01, IMAX Laser, 4DX, ScreenX). Một rạp có nhiều phòng với cấu hình máy chiếu, âm thanh khác nhau.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• cinema_id (FK -> cinemas.id)&lt;br/&gt;• name (Tên phòng)&lt;br/&gt;• hall_type (2D, 3D, IMAX, 4DX)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_3" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#047857;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#3. seat_templates&lt;/b&gt; (Sơ Đồ Ghế Vật Lý Cố Định)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Sơ đồ ghế vật lý bắt ốc vít cố định trong phòng chiếu (A1, A2, B1...). Thiết lập 1 lần dùng mãi mãi, định vị tọa độ X-Y trên màn hình vẽ.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• hall_id (FK -> halls.id)&lt;br/&gt;• row_code (Mã hàng: A, B, C...)&lt;br/&gt;• seat_number (Số ghế: 1, 2, 3...)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="820" y="60" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_4" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#4338ca;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#4. genres&lt;/b&gt; (Thể Loại Phim)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Danh mục phân loại phim (Hành động, Viễn tưởng, Hoạt hình, Kinh dị, Tâm lý, Hài...) để khách hàng lọc phim theo sở thích.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• name (Tên thể loại)&lt;br/&gt;• slug (Đường dẫn url)&lt;br/&gt;• description (Mô tả thể loại)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1200" y="60" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_5" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#4338ca;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#5. movies&lt;/b&gt; (Kho Phim Điện Ảnh)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Thông tin chi tiết các bộ phim nhập về chiếu tại rạp (Tên phim, thời lượng, nhãn tuổi T13/T18, đạo diễn, trailer Youtube, poster, điểm đánh giá).&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• title (Tên phim)&lt;br/&gt;• duration_min (Thời lượng phút)&lt;br/&gt;• age_rating (Phân loại độ tuổi ENUM)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1580" y="60" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_6" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#4338ca;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#6. movie_genres&lt;/b&gt; (Nối Phim & Thể Loại (N:M))&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Bảng cầu nối Nhiều - Nhiều (N:M). Một bộ phim có thể thuộc nhiều thể loại, và một thể loại có thể có hàng trăm bộ phim.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• movie_id (FK -> movies.id)&lt;br/&gt;• genre_id (FK -> genres.id)&lt;br/&gt;• PRIMARY KEY (movie_id, genre_id)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_7" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#4338ca;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#7. showtimes&lt;/b&gt; (Lịch Suất Chiếu)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Xếp lịch chiếu: Phim nào chiếu ở phòng nào, vào khung giờ nào (bắt đầu - kết thúc), định dạng 2D hay 3D, giá vé cơ bản bao nhiêu.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• movie_id (FK -> movies.id)&lt;br/&gt;• hall_id (FK -> halls.id)&lt;br/&gt;• start_time, end_time (Giờ chiếu)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="330" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_8" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#4338ca;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#8. showtime_seats&lt;/b&gt; (Trạng Thái Ghế Động Theo Suất)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 ⭐ BẢNG THEN CHỐT CỦA CẢ HỆ THỐNG. Cùng là ghế F7 nhưng suất 18h đã bán, suất 20h còn trống. Bảng này quản lý ghế theo từng giờ và cơ chế giữ chỗ tạm thời 5 phút.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• showtime_id (FK -> showtimes.id)&lt;br/&gt;• seat_template_id (FK -> seat_templates.id)&lt;br/&gt;• status (AVAILABLE, HOLD, BOOKED, BLOCKED)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="820" y="330" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_9" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#b45309;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#9. users&lt;/b&gt; (Tài Khoản & Người Dùng)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Quản lý tất cả tài khoản trong hệ thống: Khách mua vé (CUSTOMER), Nhân viên soát vé (STAFF), Quản lý chi nhánh (CINEMA_MANAGER), Super Admin.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• full_name (Họ tên)&lt;br/&gt;• email (Email duy nhất)&lt;br/&gt;• phone (Số điện thoại)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1200" y="330" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_10" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#b45309;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#10. bookings&lt;/b&gt; (Đơn Đặt Vé Tổng)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Hóa đơn tổng của một lần mua vé: Lưu mã đơn hàng, tổng tiền vé + bắp nước, tiền giảm giá voucher, trạng thái thanh toán và mã chống trùng.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• booking_code (Mã đơn duy nhất)&lt;br/&gt;• user_id (FK -> users.id)&lt;br/&gt;• showtime_id (FK -> showtimes.id)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1580" y="330" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_11" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#b45309;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#11. tickets&lt;/b&gt; (Vé Điện Tử Chi Tiết)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Chi tiết từng tấm vé điện tử. Đơn mua 3 ghế thì in ra 3 vé. Mỗi vé có mã QR riêng biệt và duy nhất để nhân viên cầm máy quét khi khách vào cửa rạp.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• booking_id (FK -> bookings.id)&lt;br/&gt;• showtime_seat_id (FK -> showtime_seats.id UNIQUE)&lt;br/&gt;• ticket_code (Mã vé duy nhất)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_12" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#c2410c;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#12. concessions&lt;/b&gt; (Menu Đồ Ăn Bắp Nước F&B)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Danh mục đồ ăn thức uống bán tại quầy rạp (Bắp ngọt, bắp phô mai, bắp caramel, Coca-Cola lớn, Combo đôi tình nhân, xúc xích...).&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• cinema_id (FK -> cinemas.id)&lt;br/&gt;• name (Tên món)&lt;br/&gt;• category (COMBO, POPCORN, DRINK, SNACK)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c2d12;strokeColor=#f97316;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="600" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_13" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#c2410c;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#13. booking_concessions&lt;/b&gt; (Chi Tiết Bắp Nước Trong Đơn)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Lưu khách mua kèm những món bắp nước nào và số lượng bao nhiêu trong đơn đặt vé xem phim.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• booking_id (FK -> bookings.id)&lt;br/&gt;• concession_id (FK -> concessions.id)&lt;br/&gt;• quantity (Số lượng mua)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c2d12;strokeColor=#f97316;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="820" y="600" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_14" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#c2410c;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#14. concession_deliveries&lt;/b&gt; (Dịch Vụ Giao Bắp Nước Tận Ghế)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Tính năng VIP tiện lợi: Khách lười đứng xếp hàng ở quầy đông đúc, chọn nhân viên mang combo bắp nước đến tận ghế ngồi F7 trước giờ chiếu phim.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• booking_id (FK -> bookings.id)&lt;br/&gt;• delivery_type (Nhận tại quầy / Giao tận ghế)&lt;br/&gt;• seat_location (Vị trí ghế: ví dụ Ghế F7)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c2d12;strokeColor=#f97316;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1200" y="600" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_15" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#be123c;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#15. payments&lt;/b&gt; (Lịch Sử Giao Dịch Thanh Toán)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Lưu vết dòng tiền chuyển khoản qua cổng MoMo, VNPay, ZaloPay, VietQR, lưu mã giao dịch ngân hàng và nội dung webhook để đối soát kế toán.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• booking_id (FK -> bookings.id)&lt;br/&gt;• gateway (MOMO, VNPAY, ZALOPAY, VIETQR)&lt;br/&gt;• gateway_transaction_id (Mã giao dịch ngân hàng)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#881337;strokeColor=#f43f5e;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1580" y="600" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_16" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#be123c;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#16. system_audit_logs&lt;/b&gt; (Nhật Ký An Ninh & Kiểm Toán Hệ Thống)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Chiếc "Camera giám sát" của phần mềm: Ghi lại mọi hành động nhạy cảm của nhân viên và quản trị viên (sửa giá vé, hủy vé, duyệt hoàn tiền, đổi suất chiếu) để chống gian lận.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (BIGSERIAL PK)&lt;br/&gt;• user_id (Người thực hiện)&lt;br/&gt;• action (Hành động: CREATE, UPDATE_PRICE, REFUND...)&lt;br/&gt;• resource_type, resource_id (Đối tượng bị tác động)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#881337;strokeColor=#f43f5e;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="870" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_17" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#be123c;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#17. refund_requests&lt;/b&gt; (Yêu Cầu Hoàn Vé & Đổi Vé)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Cho phép khách gửi yêu cầu trả vé hoàn tiền khi có việc đột xuất trước giờ chiếu (chính sách rạp quy định hủy trước 60 phút, trừ phí phạt nhẹ).&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• booking_id (FK -> bookings.id)&lt;br/&gt;• user_id (FK -> users.id)&lt;br/&gt;• reason (Lý do hoàn)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#881337;strokeColor=#f43f5e;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="870" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_18" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#7e22ce;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#18. membership_tiers&lt;/b&gt; (Hạng Thành Viên Thân Thiết)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Quản lý cấp bậc hội viên (Đồng, Bạc, Vàng, Kim Cương) để tính hệ số nhân điểm thưởng và đặc quyền giảm giá tặng quà cho khách hàng trung thành.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• tier_name (Đồng, Bạc, Vàng, Bạch Kim, Kim Cương)&lt;br/&gt;• min_spending (Mức chi tiêu tối thiểu để lên hạng)&lt;br/&gt;• point_multiplier (Hệ số nhân điểm)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581c87;strokeColor=#a855f7;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="820" y="870" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_19" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#7e22ce;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#19. user_loyalty_transactions&lt;/b&gt; (Sổ Cái Điểm Thưởng Thành Viên)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Sổ cái ghi chép từng lần cộng / trừ điểm thưởng như sao kê ngân hàng: Mua vé tích điểm, dùng điểm đổi voucher, trừ điểm hết hạn... minh bạch và chống hack điểm.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• user_id (FK -> users.id)&lt;br/&gt;• booking_id (FK -> bookings.id)&lt;br/&gt;• points_delta (Số điểm cộng/trừ: dương là cộng, âm là trừ)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581c87;strokeColor=#a855f7;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1200" y="870" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_20" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#7e22ce;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#20. coupons&lt;/b&gt; (Kho Mã Giảm Giá & Voucher)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Quản lý các chương trình khuyến mãi (Ví dụ mã CINEMAX2026 giảm 20%), quy định thời hạn áp dụng, giá trị đơn tối thiểu và giới hạn số lượt dùng.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• code (Mã voucher: CINEMAX2026)&lt;br/&gt;• discount_type (PERCENTAGE hoặc FIXED_AMOUNT)&lt;br/&gt;• discount_value (Mức giảm 20% hoặc 50.000đ)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581c87;strokeColor=#a855f7;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1580" y="870" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_21" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#7e22ce;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#21. coupon_redemptions&lt;/b&gt; (Lịch Sử Sử Dụng Voucher)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Lưu vết ai đã áp mã giảm giá nào vào đơn hàng nào, để hệ thống tự động kiểm tra và chặn ngay nếu một người cố tình dùng 1 voucher nhiều lần vượt quá quy định.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• coupon_id (FK -> coupons.id)&lt;br/&gt;• user_id (FK -> users.id)&lt;br/&gt;• booking_id (FK -> bookings.id)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581c87;strokeColor=#a855f7;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="1140" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_22" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#7e22ce;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#22. gift_cards&lt;/b&gt; (Thẻ Quà Tặng Điện Tử (Ví Trả Trước))&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Thẻ quà tặng nạp sẵn tiền (ví dụ 500k) để gửi tặng sinh nhật người yêu, bạn bè qua email kèm lời chúc ý nghĩa và mã PIN bảo mật.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• card_code (Mã số thẻ quà tặng)&lt;br/&gt;• pin_hash (Mã PIN băm bảo mật)&lt;br/&gt;• initial_balance, current_balance (Số dư ban đầu và hiện tại)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581c87;strokeColor=#a855f7;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="1140" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_23" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#7e22ce;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#23. gift_card_transactions&lt;/b&gt; (Lịch Sử Trừ Tiền Thẻ Quà Tặng)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Ghi lại chi tiết từng lần quẹt thẻ quà tặng để thanh toán tiền vé và số dư còn lại sau mỗi lần trừ tiền.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• gift_card_id (FK -> gift_cards.id)&lt;br/&gt;• booking_id (FK -> bookings.id)&lt;br/&gt;• amount_deducted (Số tiền trừ)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581c87;strokeColor=#a855f7;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="820" y="1140" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_24" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#0e7490;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#24. movie_reviews&lt;/b&gt; (Đánh Giá & Nhận Xét Phim)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Khán giả chấm điểm (1 - 10 sao) và viết bài cảm nhận về phim. Có nhãn Verified Buyer (Đã mua vé thật) như Rotten Tomatoes để chống nick ảo đánh giá bẩn.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• movie_id (FK -> movies.id)&lt;br/&gt;• user_id (FK -> users.id)&lt;br/&gt;• booking_id (FK -> bookings.id chứng thực mua vé)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#164e63;strokeColor=#06b6d4;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1140" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_25" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#0e7490;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#25. review_likes&lt;/b&gt; (Lượt Thích Bình Luận Phim)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Quản lý việc người xem bấm Thả Tim / Hữu Ích cho bài bình luận hay. Khóa chính phức hợp bảo đảm mỗi người chỉ được bấm like 1 lần.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• review_id (FK -> movie_reviews.id)&lt;br/&gt;• user_id (FK -> users.id)&lt;br/&gt;• created_at&lt;br/&gt;• PRIMARY KEY (review_id, user_id)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#164e63;strokeColor=#06b6d4;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1140" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_26" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#0e7490;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#26. movie_watchlists&lt;/b&gt; (Theo Dõi Phim Sắp Ra Rạp)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Khán giả bấm chuông theo dõi phim bom tấn sắp chiếu (như Avatar 3, Avengers) để hệ thống tự động gửi email thông báo ngay khi rạp mở bán vé sớm (Presale Alert).&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• user_id (FK -> users.id)&lt;br/&gt;• movie_id (FK -> movies.id)&lt;br/&gt;• notify_on_presale (Muốn nhận thông báo vé sớm)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#164e63;strokeColor=#06b6d4;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="1410" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_27" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#0e7490;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#27. group_bookings&lt;/b&gt; (Đặt Vé Theo Nhóm Bạn Bè)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Tính năng rủ bạn bè đi xem phim: Trưởng nhóm tạo phòng, gửi link mời qua Zalo để bạn bè cùng tham gia tự chọn ghế ngồi cạnh nhau và tự chia tiền vé (Split Bill).&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• leader_user_id (Trưởng nhóm tạo phòng)&lt;br/&gt;• showtime_id (Suất chiếu chung)&lt;br/&gt;• group_name (Tên nhóm)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#164e63;strokeColor=#06b6d4;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="1410" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_28" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#0e7490;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#28. group_booking_members&lt;/b&gt; (Thành Viên Trong Nhóm Xem Phim)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Danh sách chi tiết từng người bạn tham gia vào phòng nhóm xem phim, ghi nhận bạn nào đã chọn ghế nào và đã thanh toán tiền vé phần mình hay chưa.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• group_booking_id (FK -> group_bookings.id)&lt;br/&gt;• user_id (FK -> users.id)&lt;br/&gt;• guest_name (Tên hiển thị)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#164e63;strokeColor=#06b6d4;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="820" y="1410" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="table_29" value="&lt;div style="font-family:Helvetica;padding:4px;"&gt;&lt;div style="background-color:#0e7490;color:#ffffff;padding:4px;border-radius:4px;font-size:12px;text-align:center;"&gt;&lt;b&gt;#29. waiting_room_sessions&lt;/b&gt; (Phòng Chờ Ảo Chống Sập Web)&lt;/div&gt;&lt;div style="font-size:10px;color:#cbd5e1;margin-top:6px;line-height:1.3;"&gt;&lt;i&gt;💡 Hệ thống xếp hàng ảo (Virtual Waiting Room): Khi phim bom tấn mở bán có 100.000 người cùng ùa vào web 1 lúc, hệ thống xếp hàng từng đợt để máy chủ rạp phim không bao giờ bị nghẽn sập.&lt;/i&gt;&lt;/div&gt;&lt;hr style="border:0;border-top:1px solid #475569;margin:6px 0;"/&gt;&lt;div style="font-size:10px;color:#94a3b8;font-family:monospace;"&gt;• id (UUID PK)&lt;br/&gt;• showtime_id (Suất chiếu đang quá tải)&lt;br/&gt;• user_ip (IP người dùng)&lt;br/&gt;• session_token (Mã phiên xếp hàng)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#164e63;strokeColor=#06b6d4;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1410" width="320" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>