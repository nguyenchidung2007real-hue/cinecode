# Khóa API của Groq (Tốc độ phản hồi cực nhanh ~500 tokens/s)
# Lấy miễn phí tại: https://console.groq.com/
GROQ_API_KEY=

# Khóa API của The Movie Database (TMDB v3 API Key)
# Lấy miễn phí tại: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Khóa API Hugging Face (Dùng cho Semantic Search & RAG Vector Embedding)
# Lấy miễn phí tại: https://huggingface.co/settings/tokens (quyền "Make calls to Inference Providers")
HF_TOKEN=
HF_EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
# HF_EMBEDDING_ENDPOINT=
# HF_EMBEDDING_QUERY_PREFIX=
# HF_EMBEDDING_PASSAGE_PREFIX=

# Nếu để trống các khóa trên, website sẽ tự động chạy chế độ Mock Data & Lexical Search chất lượng cao!
NEXT_PUBLIC_APP_NAME=CineMax AI

# ---------------------------------------------------------
# BẢO MẬT & PHÂN QUYỀN HỆ THỐNG (AUTHENTICATION & SECRETS)
# ---------------------------------------------------------

# Mật khẩu người quản trị đăng nhập /admin (Bắt buộc trên production, tối thiểu 8 ký tự)
ADMIN_LOGIN_PASSWORD=

# Khóa bí mật ký cookie phiên đăng nhập Admin (HMAC-SHA256, tối thiểu 32 ký tự ngẫu nhiên)
ADMIN_SESSION_SECRET=

# Khóa bí mật giao tiếp máy chủ (Machine-to-Machine / Cron / Crawler)
ADMIN_SYNC_SECRET=

# Khóa bí mật ký số vé điện tử QR Code (Bắt buộc trên production để chống làm giả vé)
TICKET_SIGNING_SECRET=

# Danh sách tài khoản nhân viên soát vé tại cửa /scanner
# Định dạng: "ID:Passcode:Họ tên,ID2:Passcode2:Họ tên 2"
STAFF_ACCOUNTS=NV01:1234:Nguyễn Văn A,NV02:5678:Trần Thị B

# Khóa bí mật soát vé dùng chung dự phòng (nếu không cấu hình STAFF_ACCOUNTS)
STAFF_SCAN_SECRET=

# ---------------------------------------------------------
# KHO LƯU TRỮ TRỰC TUYẾN (UPSTASH REDIS / VERCEL KV)
# ---------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

